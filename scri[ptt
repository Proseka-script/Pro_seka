    if input.KeyCode == Enum.KeyCode.RightControl then
        MainFrame.Visible = not MainFrame.Visible
    elseif input.KeyCode == Enum.KeyCode.F and not gameProcessed then
        if toggleFly then
            toggleFly(not flyEnabled)
        end
    elseif input.KeyCode == Enum.KeyCode.N and not gameProcessed then
        if toggleNoclip then
            toggleNoclip(not noclipEnabled)
        end
    end
end)

