local function getMyPlot()
    local possibleFolderNames = {"Plots", "Tycoons", "Bases", "PlayerPlots", "UserPlots", "Islands", "PlayerBases"}
    local plotsFolder = nil
    
    for _, name in ipairs(possibleFolderNames) do
        plotsFolder = Workspace:FindFirstChild(name)
        if plotsFolder then break end
    end
    
    if plotsFolder then
        for _, plot in pairs(plotsFolder:GetChildren()) do
            if plot.Name == player.Name or string.find(string.lower(plot.Name), string.lower(player.Name)) then 
                return plot 
            end
            
            for _, attr in ipairs({"Owner", "Player", "UserId", "Client", "Builder"}) do
                local val = plot:GetAttribute(attr)
                if val == player or val == player.UserId or val == player.Name or val == tostring(player.UserId) then 
                    return plot 
                end
            end
            
            for _, childName in ipairs({"Owner", "Player", "Sign", "Data", "Info"}) do
                local obj = plot:FindFirstChild(childName, true)
                if obj then
                    if obj:IsA("ObjectValue") and obj.Value == player then return plot end
                    if obj:IsA("StringValue") and (obj.Value == player.Name or obj.Value == tostring(player.UserId)) then return plot end
                    if obj:IsA("TextLabel") and string.find(obj.Text, player.Name) then return plot end
                end
            end
        end
    end
    
    local foundByName = Workspace:FindFirstChild(player.Name, true)
    if foundByName and (foundByName:IsA("Model") or foundByName:IsA("BasePart") or foundByName:IsA("Folder")) then
        return foundByName
    end
    
    return nil
end

local function hasEggInBasket(plr)
    local basket = plr:FindFirstChild("Basket")
    if basket and #basket:GetChildren() > 0 then return true end
    return false
end

local function getClosestEgg(rootPos)
    if not renderedEggs then return nil end
    local closestEgg = nil
    local minDistance = math.huge
    
    for _, egg in pairs(renderedEggs:GetChildren()) do
        if targetEggs[egg.Name] then
            local pivot = egg:GetPivot()
            if pivot then
                local dist = (pivot.Position - rootPos).Magnitude
                if dist < minDistance then
                    minDistance = dist
                    closestEgg = egg
                end
            end
        end
    end
    return closestEgg
end

local function interactPrompt(prompt)
    if fireproximityprompt then
        pcall(function() fireproximityprompt(prompt) end)
    else
        pcall(function()
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration or 0.1)
            prompt:InputHoldEnd()
        end)
    end
end

local function teleportToMyPlot(rootPart)
    local myPlot = getMyPlot()
    if myPlot then
        local plotCFrame = nil
        if myPlot:IsA("Model") then
            plotCFrame = myPlot.PrimaryPart and myPlot.PrimaryPart.CFrame or myPlot:GetPivot()
        elseif myPlot:IsA("BasePart") then
            plotCFrame = myPlot.CFrame
        elseif myPlot:IsA("Folder") then
            for _, child in pairs(myPlot:GetChildren()) do
                if child:IsA("BasePart") then
                    plotCFrame = child.CFrame
                    break
                elseif child:IsA("Model") then
                    plotCFrame = child:GetPivot()
                    break
                end
            end
        end
        
        if plotCFrame then
            rootPart.CFrame = plotCFrame + Vector3.new(0, 5, 0)
            task.wait(1.5)
            return true
        end
    end
    
    warn("⚠️ Ваш Plot не найден! Убедитесь, что база куплена или установлена.")
    return false
end

local function doAutoFarm()
    while autoFarmEnabled do
        local char = player.Character
        local rootPart = char and char:FindFirstChild("HumanoidRootPart")
        
        if rootPart then
            if hasEggInBasket(player) then
                teleportToMyPlot(rootPart)
            else
                local egg = getClosestEgg(rootPart.Position)
                if egg then
                    local pivot = egg:GetPivot()
                    if pivot then
                        local eggPos = pivot.Position
                        rootPart.CFrame = CFrame.new(eggPos + Vector3.new(0, 0, 2), eggPos)
                        rootPart.Anchored = true
                        
                        local prompt = nil
                        for _, desc in pairs(egg:GetDescendants()) do
                            if desc:IsA("ProximityPrompt") then
                                prompt = desc
                                break
                            end
                        end
                        
                        if prompt then
                            interactPrompt(prompt)
                            local waitTime = 0
                            while waitTime < 1.5 and autoFarmEnabled do
                                if hasEggInBasket(player) then break end
                                waitTime = waitTime + task.wait(0.1)
                            end
                        end
                        
                        rootPart.Anchored = false
                        if hasEggInBasket(player) then
                            teleportToMyPlot(rootPart)
                        end
                    end
                end
            end
        end
        task.wait(0.2)
    end
    
    if player.Character then
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = false end
    end
end

