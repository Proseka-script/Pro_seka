local function clearESP()
    for _, gui in pairs(activeESPs) do
        if gui and gui.Parent then gui.Parent:Destroy() end
    end
    table.clear(activeESPs)
    if espConnection then
        espConnection:Disconnect()
        espConnection = nil
    end
end

local function createESP(egg)
    if not egg or not egg.Name then return end
    if targetEggs[egg.Name] then
        if egg:FindFirstChild("EggESP") then return end
        local adornee = egg:IsA("Model") and (egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart")) or egg
        if not adornee then return end

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "EggESP"
        billboard.AlwaysOnTop = true
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.MaxDistance = math.huge
        billboard.Adornee = adornee
        
        local text = Instance.new("TextLabel")
        text.Size = UDim2.new(1, 0, 1, 0)
        text.BackgroundTransparency = 1
        text.Text = egg.Name
        text.TextColor3 = Color3.fromRGB(255, 215, 0) -- Золотой цвет для целевых
        text.TextStrokeTransparency = 0.2
        text.TextSize = 14
        text.Font = Enum.Font.GothamBold
        text.Parent = billboard
        
        billboard.Parent = egg
        activeESPs[egg] = text
    end
end

local function updateESP()
    clearESP()
    if espEnabled then
        if renderedEggs then
            for _, egg in pairs(renderedEggs:GetChildren()) do createESP(egg) end
        end
        
        espConnection = RunService.RenderStepped:Connect(function()
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            for egg, textLabel in pairs(activeESPs) do
                if egg and egg.Parent and root then
                    local pivot = egg:GetPivot()
                    if pivot then
                        local distance = math.floor((pivot.Position - root.Position).Magnitude)
                        textLabel.Text = egg.Name .. "\n[" .. tostring(distance) .. "m]"
                    end
                elseif not egg or not egg.Parent then
                    if textLabel and textLabel.Parent then textLabel.Parent:Destroy() end
                    activeESPs[egg] = nil
                end
            end
        end)
    end
end

